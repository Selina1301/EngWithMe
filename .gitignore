# EngWithMe Enterprise - Git Ignore Configuration

# Dependencies
be/node_modules/
node_modules/

# Environment Configurations & Credentials
be/.env
.env

# Storage & Temporary Files
be/storage/logs/*.log
!be/storage/logs/.gitkeep
be/storage/sessions/sess_*
!be/storage/sessions/.gitkeep
be/storage/uploads/*
!be/storage/uploads/.gitkeep
be/uploads/avatars/*
!be/uploads/avatars/.gitkeep

# OS / IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
